func fatorial(number n) -> number {
    var fat = 1;
    var i = 1;
    while (i <= n) {
        fat = fat * i;
        i = i + 1;
    }
    return fat;
}

func fibonacci(number limite) -> list {
    var serie = [];
    var a = 0;
    var b = 1;
    var i = 0;
    while (i < limite) {
        serie.append(a);
        var prox = a + b;
        a = b;
        b = prox;
        i = i + 1;
    }
    return serie;
}

par {
    seq {
        print("Fatorial de 5:", fatorial(5));
    }
    seq {
        var serie = fibonacci(8);
        print("Fibonacci:");
        for (var valor in serie) {
            print(valor);
        }
    }
}
