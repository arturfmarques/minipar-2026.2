.syntax unified
.arch armv7-a
.arm
.global _start
.global __expr_done
.text
.balign 4
_start:
    ldr sp, =__expr_stack_top
    mov r12, #0
    ldr r0, =10
    push {r0, r1}
    ldr r0, =8
    push {r0, r1}
    ldr r0, =7
    pop {r1, r2}
    mul r2, r1, r0
    mov r0, r2
    pop {r1, r2}
    sub r0, r1, r0
    push {r0, r1}
    ldr r0, =4
    pop {r1, r2}
    add r0, r1, r0
    push {r0, r1}
    ldr r0, =2
    pop {r1, r2}
    mul r2, r1, r0
    mov r0, r2
__expr_done:
    b __expr_done
.ltorg
.data
.balign 4
.bss
.balign 8
__expr_stack:
.space 65536
__expr_stack_top:
