
# ============================================================
# MiniPar 2026.2 - Git Ignore
# ============================================================

# Arquivos gerados pelo compilador e pelas interfaces
/output/
/temp_code/
/build/
/dist/

# Arquivos de compilacao temporarios
*.exe
*.o
*.obj
*.out
*.dll
*.pyd
*.class

# Executaveis e arquivos antigos gerados na raiz
/meu_teste.cpp
/meu_teste.exe
/minipar_compiler.exe

# Cache do Python
__pycache__/
*.py[cod]
*$py.class

# Ambientes virtuais Python
.venv/
venv/
env/
.audit-venv/
.tox/
.nox/

# Arquivos de configuracao e segredos locais
.env
.env.*
!.env.example

# Caches e relatorios de ferramentas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/
.pytype/
.hypothesis/

# Dependencias e caches do Node.js
node_modules/
.npm/
.nyc_output/

# Configuracoes locais do editor
.vscode/
.idea/
*.swp
*.swo
*~

# Arquivos temporarios do sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Pastas de referencia utilizadas apenas no desenvolvimento
/referencias/
/minipar-improvement/

# Materiais locais nao destinados a publicacao
/docs/evidencias/fontes-locais/

# Relatorios e arquivos temporarios de auditoria
/docs/evidencias/pytest*.xml
/docs/evidencias/git-add-*.txt
